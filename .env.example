# ======================================================================
# AutoSOC Command Center — environment configuration
# Copy to .env and adjust. The platform runs fully offline with the mock
# provider; add provider keys only for the integrations you want.
# ======================================================================

# --- App ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security / Auth ---
JWT_SECRET=change-me-in-production-please-use-32-bytes-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SEED_ADMIN_EMAIL=admin@autosoc.local
SEED_ADMIN_PASSWORD=Admin123!

# --- Database ---
DATABASE_URL=postgresql+psycopg2://autosoc:autosoc@postgres:5432/autosoc

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Vector memory ---
QDRANT_URL=http://qdrant:6333
VECTOR_BACKEND=memory   # memory | qdrant | pgvector

# ======================================================================
# AI ROUTING
# ======================================================================
DEFAULT_AI_PROVIDER=mock
DEFAULT_AI_MODEL=mock-soc-1
AI_FALLBACK_CHAIN=mock
AI_ROUTING_MODE=auto    # auto|cost|quality|privacy|speed|soc_critical|offline
AI_STRICT_JSON_MODE=true
AI_ENABLE_FALLBACK=true
AI_ENABLE_COST_TRACKING=true
AI_ENABLE_OUTPUT_QA=true
AI_ENABLE_PII_REDACTION=true
AI_REQUEST_TIMEOUT=60
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# Example production chain (uncomment and add keys):
# DEFAULT_AI_PROVIDER=openai
# DEFAULT_AI_MODEL=gpt-4.1-mini
# AI_FALLBACK_CHAIN=openai,anthropic,openrouter,ollama,mock

# ======================================================================
# PROVIDER CREDENTIALS (all optional)
# ======================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

COHERE_API_KEY=
COHERE_MODEL=command-r-plus

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

GENERIC_OPENAI_BASE_URL=
GENERIC_OPENAI_API_KEY=
GENERIC_OPENAI_MODEL=local-model

# --- Local LLMs ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=local-model

# ======================================================================
# ENRICHMENT PROVIDER KEYS (all optional; mock enrichment always works)
# ======================================================================
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
